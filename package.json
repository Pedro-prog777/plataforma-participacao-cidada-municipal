{
  "name": "plataforma-participacao-cidada-municipal",
  "version": "0.1.0",
  "private": true,
  "description": "PPCM — Plataforma de Participação Cidadã Municipal (CESMAC, Engenharia de Software)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "jobs:tick": "tsx scripts/jobs.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "setup": "npm run db:reset"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.4",
    "next": "15.5.29",
    "nodemailer": "^10.5.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.32"
    }
  }
}

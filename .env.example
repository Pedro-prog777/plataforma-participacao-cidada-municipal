# =====================================================================
# PPCM — variáveis de ambiente (EXEMPLO). Copie para .env e preencha.
# NUNCA versione o arquivo .env nem coloque segredos reais aqui.
# =====================================================================

# --- Banco de dados ---------------------------------------------------
# PostgreSQL real (produção / docker compose). Ex.: postgres://usuario:senha@localhost:5432/ppcm
# Se ficar vazio, o sistema usa PGlite (PostgreSQL em WebAssembly) em PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=./.data/pglite

# --- Segredos (gere valores aleatórios longos: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`)
# Chave do HMAC do CPF (unicidade sem guardar CPF puro). Fica FORA do banco.
CPF_HMAC_KEY=
# Chave para cifrar segredos de segundo fator (AES-256-GCM, 32 bytes em base64url).
DATA_ENCRYPTION_KEY=
# Chave para assinar tokens sem estado (CAPTCHA, descadastro de e-mail).
APP_SIGNING_KEY=

# --- Aplicação ----------------------------------------------------------
APP_URL=http://localhost:3000
MUNICIPIO_NOME=Município de Porto Alecrim
MUNICIPIO_UF=XX
# Modo demonstração acadêmica: habilita caixa de e-mail simulada, provedor de identidade simulado
# e códigos TOTP de contas de exemplo. DEVE ser false em produção.
DEMO_MODE=true
# Rotina automática (RF019) dentro do processo do servidor (true/false).
SCHEDULER_ENABLED=true

# --- Integrações externas (vazias = adaptadores simulados) -------------
# gov.br (OpenID Connect). Requer credenciamento oficial; sem isso, o provedor simulado é usado.
GOVBR_ISSUER=
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
# SMTP real. Vazio = e-mails ficam na caixa de saída do banco (visível em /demo/caixa-de-email no DEMO_MODE).
SMTP_URL=
# ClamAV (clamd) para antivírus de anexos. Vazio = verificação embutida (assinaturas básicas, ex.: EICAR).
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Armazenamento de arquivos -----------------------------------------
STORAGE_DIR=./storage
